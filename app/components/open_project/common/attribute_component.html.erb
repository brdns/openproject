<%= render(
      OpPrimer::ExpandableTextComponent.new(
        truncation: :vertical,
        lines: lines,
        inline: false,
        classes: "op-long-text-attribute",
        expander_arguments: {
          hidden: !show_expander?,
          inline: false,
          aria: { label: I18n.t("label_attribute_expand_text", attribute: name) },
          button_arguments: { "data-show-dialog-id": id },
          classes: "op-long-text-attribute--text-expander",
          data: { "test-selector": "expand-button" }
        }
      )
    ) do %>
  <%= render(
        Primer::Beta::Text.new(
          tag: :span,
          classes: PARAGRAPH_CSS_CLASS,
          color: text_color
        )
      ) { short_text } %>
<% end %>

<%= render(
      Primer::Alpha::Dialog.new(
        id: id,
        data: { "test-selector": "attribute-dialog" },
        title: name,
        size: :large
      )
    ) do |component|
      component.with_body { full_text }
      component.with_header(variant: :large)
    end %>
